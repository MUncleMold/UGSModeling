<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UGSModeling.BuildGraph"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
             xmlns:local="clr-namespace:UGSModeling.ViewModels"
             Title="ПОСТРОИТЬ ГРАФИК">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <!-- Основная область -->
            <VerticalStackLayout MaximumWidthRequest="1100" HorizontalOptions="Center" Spacing="10">
                <Label Text="{Binding LbText}" HorizontalOptions="Center" />
                <!-- График -->
                <Border Padding="10" StrokeThickness="1" HorizontalOptions="Fill">
                    <chart:SfCartesianChart x:Name="graph" Title="{Binding GraphName}" HeightRequest="450">
                        <chart:SfCartesianChart.XAxes>
                            <chart:CategoryAxis>
                                <chart:CategoryAxis.Title>
                                    <chart:ChartAxisTitle Text="{Binding XAxesTitle}"/>
                                </chart:CategoryAxis.Title>
                            </chart:CategoryAxis>
                        </chart:SfCartesianChart.XAxes>
                        <chart:SfCartesianChart.YAxes>
                            <chart:NumericalAxis>
                                <chart:NumericalAxis.Title>
                                    <chart:ChartAxisTitle Text="{Binding YAxesTitle}"/>
                                </chart:NumericalAxis.Title>
                            </chart:NumericalAxis>
                        </chart:SfCartesianChart.YAxes>
                        <chart:SfCartesianChart.Series>
                            <chart:LineSeries ItemsSource="{Binding GraphData}" XBindingPath="X" YBindingPath="Y" ShowDataLabels="True"/>
                        </chart:SfCartesianChart.Series>
                    </chart:SfCartesianChart>
                </Border>
                <!-- Название графика -->
                <Entry x:Name="GraphSaveName" Placeholder="Заголовок" Text="{Binding GraphName}" HorizontalOptions="Fill" />
                <Label TextColor="Red" Text="{Binding BuildGraphErr}" HorizontalOptions="Center" />
                <!-- Кнопки -->
                <Grid ColumnSpacing="10" HorizontalOptions="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Text="Построить график" Command="{Binding BuildGraphCommand}" MinimumWidthRequest="180"/>
                    <Button Grid.Column="1" Text="Сохранить график" Clicked="SaveGraphAsImage" Command="{Binding SaveGraphCommand}" MinimumWidthRequest="180"/>
                </Grid>
                <!-- ВЫБОР ДАННЫХ -->
                <Label HorizontalOptions="Center" Text="ВЫБОР ДАННЫХ" Margin="0,10,0,0"/>
                <Grid ColumnSpacing="20" HorizontalOptions="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <!-- X -->
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label HorizontalOptions="Center" Text="Данные по X"/>
                        <Picker SelectedIndex="{Binding XSelectIndex}" SelectedItem="{Binding XSelectType}" SelectedIndexChanged="XTypeChange" ItemsSource="{Binding XSelectTypes}" />
                    </VerticalStackLayout>
                    <!-- Y -->
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label HorizontalOptions="Center" Text="Данные по Y"/>
                        <Picker SelectedIndex="{Binding YSelectIndex}" ItemsSource="{Binding YSelectTypes}" IsEnabled="False" />
                    </VerticalStackLayout>
                </Grid>
                <!-- Выбор параметров X / Y -->
                <Grid ColumnSpacing="20" HorizontalOptions="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <Picker Grid.Column="0" SelectedItem="{Binding XSelectItem}" ItemsSource="{Binding XSelectItems}" IsEnabled="{Binding ParamSelectVisible}" />
                    <Picker Grid.Column="1" SelectedItem="{Binding YSelectItem}" ItemsSource="{Binding YSelectItems}" />
                </Grid>
                <!-- НАСТРОЙКА ДИАПАЗОНА -->
                <VerticalStackLayout IsVisible="{Binding DataSelectVisible}" Spacing="10">
                    <Label HorizontalOptions="Center" Text="НАСТРОЙКА ДИАПАЗОНА" Margin="0,5,0,0"/>
                    <Grid ColumnSpacing="20" HorizontalOptions="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>
                        <!-- Начало -->
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label HorizontalOptions="Center" Text="Начало диапазона"/>
                            <Entry Placeholder="Введите дату" Completed="StartDateTextChanged"/>
                            <DatePicker DateSelected="StartDateChanged" MinimumDate="{Binding MinStartDate}" MaximumDate="{Binding MaxStartDate}" Date="{Binding SelectedStartDate}" />
                        </VerticalStackLayout>
                        <!-- Конец -->
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label HorizontalOptions="Center" Text="Конец диапазона"/>
                            <Entry Placeholder="Введите дату" Completed="EndDateTextChanged"/>
                            <DatePicker DateSelected="EndDateChanged" MinimumDate="{Binding MinEndDate}" MaximumDate="{Binding MaxEndDate}" Date="{Binding SelectedEndDate}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
                <!-- ГРАФИКИ -->
                <Label HorizontalOptions="Center" Text="ГРАФИКИ" Margin="0,5,0,0"/>
                <Entry Placeholder="Поиск" Text="{Binding SearchGraphText}" Completed="SearchComplete"/>
                <!-- Заголовок таблицы -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0">
                        <Label Padding="5" HorizontalOptions="Center" VerticalOptions="Center" Text="X Параметр"/>
                    </Border>
                    <Border Grid.Column="1">
                        <Label Padding="5" HorizontalOptions="Center" VerticalOptions="Center" Text="Y Параметр"/>
                    </Border>
                    <Border Grid.Column="2">
                        <Label Padding="5" HorizontalOptions="Center" VerticalOptions="Center" Text="Заголовок"/>
                    </Border>
                    <Border Grid.Column="3" WidthRequest="90">
                        <Label Padding="5" HorizontalOptions="Center" VerticalOptions="Center" Text="Загрузить"/>
                    </Border>
                    <Border Grid.Column="4" WidthRequest="80">
                        <Label Padding="5" HorizontalOptions="Center" VerticalOptions="Center" Text="Удалить"/>
                    </Border>
                </Grid>
                <!-- Список графиков -->
                <Border Padding="0">
                    <CollectionView HeightRequest="150" ItemsSource="{Binding GraphsSearch}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0">
                                        <Label Padding="5" VerticalOptions="Center" LineBreakMode="TailTruncation" Text="{Binding XParam}"/>
                                    </Border>
                                    <Border Grid.Column="1">
                                        <Label Padding="5" VerticalOptions="Center" LineBreakMode="TailTruncation" Text="{Binding YParam}"/>
                                    </Border>
                                    <Border Grid.Column="2">
                                        <Label Padding="5" VerticalOptions="Center" LineBreakMode="TailTruncation" Text="{Binding GraphDesc}"/>
                                    </Border>
                                    <Border Grid.Column="3" WidthRequest="90">
                                        <Button Text="A" Padding="0" Margin="8,4" Command="{Binding Source={RelativeSource AncestorType={x:Type local:BuildGraphViewModel}}, Path=LoadGraphCommand}" CommandParameter="{Binding .}"/>
                                    </Border>
                                    <Border Grid.Column="4" WidthRequest="80">
                                        <Button Text="X" Padding="0" Margin="8,4" Command="{Binding Source={RelativeSource AncestorType={x:Type local:BuildGraphViewModel}}, Path=DeleteGraphCommand}" CommandParameter="{Binding .}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
                <!-- ПРОСМОТР ПАРАМЕТРОВ -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8" Margin="0,5,0,0">
                    <Label VerticalOptions="Center" Text="ПРОСМОТР ПАРАМЕТРОВ"/>
                    <Switch VerticalOptions="Center" Toggled="UGSCheck"/>
                </HorizontalStackLayout>
                <!-- Таблица параметров -->
                <VerticalStackLayout x:Name="UGSCheckTable" IsVisible="False" Spacing="10">
                    <Entry Placeholder="Поиск" Text="{Binding SearchParamText}" Completed="SearchComplete"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0">
                            <Label Padding="5" HorizontalOptions="Center" VerticalOptions="Center" Text="Наименование"/>
                        </Border>
                        <Border Grid.Column="1">
                            <Label Padding="5" HorizontalOptions="Center" VerticalOptions="Center" Text="Дата"/>
                        </Border>
                        <Border Grid.Column="2">
                            <Label Padding="5" HorizontalOptions="Center" VerticalOptions="Center" Text="Единицы измерения"/>
                        </Border>
                        <Border Grid.Column="3">
                            <Label Padding="5" HorizontalOptions="Center" VerticalOptions="Center" Text="Значение"/>
                        </Border>
                    </Grid>
                    <Border>
                        <CollectionView HeightRequest="150" ItemsSource="{Binding UGSSearch}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.5*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0">
                                            <Label Padding="5" VerticalOptions="Center" LineBreakMode="TailTruncation" Text="{Binding Name}"/>
                                        </Border>
                                        <Border Grid.Column="1">
                                            <Label Padding="5" HorizontalOptions="Center" VerticalOptions="Center" Text="{Binding Date}"/>
                                        </Border>
                                        <Border Grid.Column="2">
                                            <Label Padding="5" HorizontalOptions="Center" VerticalOptions="Center" LineBreakMode="TailTruncation" Text="{Binding Unit}"/>
                                        </Border>
                                        <Border Grid.Column="3">
                                            <Label Padding="5" HorizontalOptions="Center" VerticalOptions="Center" Text="{Binding Value}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </VerticalStackLayout>
                <!-- Назад -->
                <Button Text="Вернуться на главную страницу" Clicked="GoToMainPage" HorizontalOptions="Center" Margin="0,5,0,10" MinimumWidthRequest="250"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>