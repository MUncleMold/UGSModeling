<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:UGSModeling.ViewModels"
             x:Class="UGSModeling.UploadData"
             Title="ВВОД ДАННЫХ">

    <ContentPage.Resources>
        <!-- Основной стиль текста -->
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <!-- Заголовки секций -->
        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,15" />
        </Style>
        <!-- Подписи -->
        <Style x:Key="FieldTitle" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="2,0,0,5" />
        </Style>
        <!-- Поля ввода -->
        <Style x:Key="ModernEntry" TargetType="Entry">
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <!-- Основная кнопка -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <!-- Вторичная кнопка -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="48" />
        </Style>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout
    Padding="20"
    Spacing="18"
    HorizontalOptions="Center"
    WidthRequest="700">
            <!-- ========================= -->
            <!-- РУЧНОЙ ВВОД -->
            <!-- ========================= -->
            <Border  StrokeThickness="1" Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="0">
                    <Label Text="Ручной ввод" Style="{StaticResource SectionTitle}" />
                    <!-- Наименование -->
                    <Label Text="Наименование" Style="{StaticResource FieldTitle}" />
                    <Entry Style="{StaticResource ModernEntry}" Placeholder="Введите наименование" PlaceholderColor="{Binding NamePHColor}" Text="{Binding NewTaskName, Mode=TwoWay}" />
                    <!-- Дата -->
                    <Label Text="Дата" Style="{StaticResource FieldTitle}" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,0,0,12">
                        <Entry x:Name="DateEnter" Grid.Column="0" Style="{StaticResource ModernEntry}" Margin="0" Placeholder="Введите дату" PlaceholderColor="{Binding DatePHColor}" TextColor="{Binding DateTextColor}" Text="{Binding NewTaskDate, Mode=TwoWay}" />
                        <Label Grid.Column="1" Text="Сегодня"  VerticalOptions="Center" />
                        <Switch Grid.Column="2" Toggled="DateNowSelect" IsToggled="{Binding NewTaskDateToggle}" VerticalOptions="Center" />
                    </Grid>
                    <!-- Единицы измерения -->
                    <Label Text="Единицы измерения" Style="{StaticResource FieldTitle}" />
                    <Entry Style="{StaticResource ModernEntry}" Placeholder="Например: кг, м, шт." PlaceholderColor="{Binding UnitPHColor}" Text="{Binding NewTaskUnit, Mode=TwoWay}" />
                    <!-- Значение -->
                    <Label Text="Значение" Style="{StaticResource FieldTitle}" />
                    <Entry Style="{StaticResource ModernEntry}" Placeholder="Введите значение" Keyboard="Numeric" Text="{Binding NewTaskValue, Mode=TwoWay}" />
                    <!-- Ошибка -->
                    <Label Text="{Binding EntryErrText}" TextColor="#DC2626" FontSize="13" Margin="2,0,0,4" />
                    <Button Text="＋ Добавить параметр" Style="{StaticResource PrimaryButton}" Command="{Binding AddItemCommand}" />
                </VerticalStackLayout>
            </Border>
            <!-- ========================= -->
            <!-- ПРОСМОТР -->
            <!-- ========================= -->
            <Border StrokeThickness="1" Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout>
                    <Label Text="Просмотр данных" Style="{StaticResource SectionTitle}" />
                    <!-- Поиск -->
                    <SearchBar Placeholder="Поиск по параметрам..." Text="{Binding SearchText}" SearchButtonPressed="SearchComplete"  Margin="0,0,0,15" />
                    <!-- Заголовок таблицы -->
                    <Border StrokeThickness="1" Padding="5">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="2.2*,1*,1.3*,1*,0.55*" ColumnSpacing="3">
                            <Label Grid.Column="0" Text="Наименование" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="Дата" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            <Label Grid.Column="2" Text="Ед." FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            <Label Grid.Column="3" Text="Значение" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            <Label Grid.Column="4" Text=" " FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center" />
                        </Grid>
                    </Border>
                    <!-- Список -->
                    <CollectionView ItemsSource="{Binding UGSParameters}" HeightRequest="250" Margin="0,8,0,0">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                                <Label Text="Нет добавленных данных" FontSize="15"  HorizontalOptions="Center" />
                                <Label Text="Добавьте первый параметр выше" FontSize="12"  HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border   Padding="5">
                                    <Grid ColumnDefinitions="2.2*,1*,1.3*,1*,0.55*" ColumnSpacing="3" MinimumHeightRequest="45">
                                        <!-- Наименование -->
                                        <Label Grid.Column="0" Margin="4,0" Text="{Binding Name}" LineBreakMode="TailTruncation" VerticalTextAlignment="Center" />
                                        <!-- Дата -->
                                        <Label Grid.Column="1" Text="{Binding Date}" FontSize="12" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        <!-- Единица -->
                                        <Label Grid.Column="2" Text="{Binding Unit}" FontSize="12" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        <!-- Значение -->
                                        <Label Grid.Column="3" Text="{Binding Value}" FontAttributes="Bold" FontSize="13" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        <!-- Удаление -->
                                        <Button Grid.Column="4" Text="×" FontSize="18" TextColor="#DC2626"  Padding="0" HeightRequest="40" WidthRequest="40" HorizontalOptions="Center" VerticalOptions="Center" Command="{Binding Source={RelativeSource AncestorType={x:Type local:UploadViewModel}}, Path=DeleteItemCommand}" CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
            <!-- ========================= -->
            <!-- ЗАГРУЗКА ИЗ ФАЙЛА -->
            <!-- ========================= -->
            <Border StrokeThickness="1" Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout>
                    <Label Text="Загрузка из файла" Style="{StaticResource SectionTitle}" />
                    <Label Text="Добавьте данные из подготовленного файла"  FontSize="13" Margin="0,-8,0,12" />
                    <!-- Ошибка -->
                    <Border IsVisible="{Binding LoadErr}"  StrokeThickness="1" Padding="12" Margin="0,0,0,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Label Text="Не удалось загрузить файл" TextColor="#DC2626" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    </Border>
                    <Button Text="↑ Загрузить из файла" Style="{StaticResource SecondaryButton}" Command="{Binding AddItemFromFileCommand}" />
                </VerticalStackLayout>
            </Border>
            <!-- ========================= -->
            <!-- НАЗАД -->
            <!-- ========================= -->
            <Button Text="← Вернуться на главную" Style="{StaticResource SecondaryButton}" Clicked="GoToMainPage" Margin="0,0,0,10" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>